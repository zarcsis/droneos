# Line endings: everything here runs inside Linux (WSL / Docker) even when the
# checkout lives on Windows, so keep every text file LF. build.sh still
# normalises CRLF in the staged copy as a safety net - the rpi-image-gen
# submodule has its own .gitattributes and its extension-less scripts
# (rpi-image-gen, bin/ns, bin/ig) come out CRLF on a Windows checkout.
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.gpg  binary
*.img  binary
*.zst  binary
